     "settings": {
      "html": "<style>\n.fw-hero{position:relative;min-height:92vh;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-top:14vh;overflow:visible}\n.fw-hero-scrim{position:absolute;left:50%;top:8vh;transform:translateX(-50%);width:min(900px,96vw);height:46vh;z-index:1;background:radial-gradient(58% 66% at 50% 40%,rgba(4,13,25,.6),rgba(4,13,25,.26) 62%,transparent 82%)}\n.fw-hero-logo{position:relative;z-index:2;width:min(760px,82vw);opacity:0;animation:fwIn 1.1s cubic-bezier(.22,.61,.36,1) forwards .6s}\n.fw-hero-hair{position:relative;z-index:2;width:min(560px,64vw);height:1px;margin:18px auto 0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.75),transparent);opacity:0;animation:fwIn 1s forwards .9s}\n.fw-hero-slog{position:relative;z-index:2;margin-top:14px;color:#dfe9f4;letter-spacing:.16em;font-size:clamp(14px,2vw,20px);font-weight:300;opacity:0;animation:fwIn 1.1s forwards 1.1s}\n.fw-hero-dev{position:relative;z-index:2;margin-top:4vh;height:58vh;width:auto;opacity:0;animation:fwDev 1.4s cubic-bezier(.22,.61,.36,1) forwards .2s}\n.fw-hero-tail{position:relative;z-index:2;text-align:center;margin-top:3vh;opacity:0;animation:fwIn 1.1s forwards 1.5s}\n.fw-hero-tail .b{font-size:clamp(20px,3.2vw,32px);font-weight:400;color:#eef3f9}\n.fw-hero-tail .s{color:#9db0c4;font-size:clamp(13px,1.8vw,17px);margin-top:4px}\n.fw-cue{position:relative;z-index:2;margin-top:4vh;color:#9db0c4;font-size:12px;letter-spacing:.28em;text-transform:uppercase;text-align:center;opacity:0;animation:fwIn 1s forwards 2s}\n.fw-cue .ch{display:block;margin:6px auto 0;width:13px;height:13px;border-right:1.5px solid #81f0ff;border-bottom:1.5px solid #81f0ff;transform:rotate(45deg);animation:fwCue 1.8s ease-in-out infinite}\n@keyframes fwIn{to{opacity:1}}\n@keyframes fwDev{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:none}}\n@keyframes fwCue{0%,100%{transform:rotate(45deg) translate(0,0);opacity:.4}50%{transform:rotate(45deg) translate(4px,4px);opacity:1}}\n@media(max-width:767px){.fw-hero-dev{height:44vh}.fw-hero{padding-top:11vh}}\n@media(prefers-reduced-motion:reduce){.fw-hero-logo,.fw-hero-hair,.fw-hero-slog,.fw-hero-dev,.fw-hero-tail,.fw-cue{animation:none;opacity:1;transform:none}.fw-cue .ch{animation:none}}\n</style>\n<div class=\"fw-hero\">\n  <div class=\"fw-hero-scrim\" aria-hidden=\"true\"></div>\n  <img class=\"fw-hero-logo\" src=\"https://finewave.kr/wp-content/uploads/2026/07/logo-finewave-1575w.webp\" alt=\"FINEWAVE\">\n  <div class=\"fw-hero-hair\" aria-hidden=\"true\"></div>\n  <div class=\"fw-hero-slog\">Go Fine. Get Defined.</div>\n  <img class=\"fw-hero-dev\" src=\"https://finewave.kr/wp-content/uploads/2026/07/device-front-cutout-1100w.webp\" alt=\"FINEWAVE 마이크로웨이브 리프팅 장비\">\n  <div class=\"fw-hero-tail\"><div class=\"b\">Rubbing의 한계를 넘어서다.</div><div class=\"s\">방식을 바꾸면 결과가 달라집니다.</div></div>\n  <div class=\"fw-cue\">Scroll to Discover<span class=\"ch\" aria-hidden=\"true\"></span></div>\n</div>"
     },
